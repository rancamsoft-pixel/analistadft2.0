# ==============================================================================
# Bet Analyzer - Cloud Functions (Backend) Environment Configuration (.env.example)
# ==============================================================================
# Configure estas variables en su entorno local o mediante Google Cloud Secret
# Manager / Firebase Functions Secrets para producción.
# ==============================================================================

# Modo Mock de datos (Evita gastar cuotas de APIs de deportes, cuotas e IA durante desarrollo)
# true = utiliza fixtures controlados sin peticiones HTTP a proveedores de pago
# false = conecta con proveedores externos reales
APP_USE_MOCK_DATA=true

# Claves de proveedores de datos externos (Nunca incluir en cliente frontend)
GEMINI_API_KEY=your_gemini_api_key_here
API_FOOTBALL_KEY=your_api_football_key_here
THE_ODDS_API_KEY=your_the_odds_api_key_here
NEWS_API_KEY=your_news_api_key_here
