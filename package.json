{
  "name": "bet-analyzer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node tests/verify-core.js && node tests/verify-user-rules.js && node tests/verify-api-football.js && node tests/verify-odds-system.js && node tests/verify-prediction-engine.js && node tests/verify-gemini-context.js && node tests/verify-parlay-engine.js && node tests/verify-daily-agent.js && node tests/verify-pwa-final.js",
    "functions:install": "cd functions && npm install",
    "functions:build": "cd functions && npm run build",
    "functions:dev": "cd functions && npm run serve",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "firebase": "^11.4.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vite-plugin-pwa": "^1.2.0"
  }
}
