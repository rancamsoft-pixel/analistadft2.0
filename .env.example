# ==============================================================================
# Bet Analyzer - Frontend Environment Configuration (.env.example)
# ==============================================================================
# Copie este archivo como .env para desarrollo local o configure estas variables
# en su proveedor de hosting (Firebase Hosting, Cloudflare Pages, Vercel, etc.).
# ==============================================================================

# Modo Mock para desarrollo local (Sin consumo de cuotas de APIs externas)
# true = utiliza fixtures controlados sin llamar a backend ni APIs reales
# false = conecta con backend Firebase Functions / proveedores reales
VITE_APP_USE_MOCK_DATA=true

# Configuración de Firebase Client (Obtenida desde la consola de Firebase)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789000
VITE_FIREBASE_APP_ID=1:123456789000:web:abcdef123456

# URL base para Cloud Functions (Opcional en modo mock o emulador local)
# En desarrollo con emulador: http://127.0.0.1:5001/<project-id>/us-central1
# En producción: https://us-central1-<project-id>.cloudfunctions.net
VITE_API_BASE_URL=http://127.0.0.1:5001/your_project_id/us-central1
